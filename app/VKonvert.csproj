<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VKonvert</AssemblyName>
    <RootNamespace>VKonvert</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Version>2.0.0</Version>
    <Product>VKonvert</Product>
    <Company>Vishnu VK</Company>
    <Copyright>Copyright (c) 2026 Vishnu VK</Copyright>
    <Description>VKonvert: convert, compress and combine images and PDFs</Description>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <!-- Only used for its Windows pdfium.dll (page rendering); VKonvert calls pdfium directly. -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Bricolage-ExtraBold.ttf" LogicalName="brand.ttf" />
    <None Include="$(PkgDocnet_Core)\runtimes\win-x64\native\pdfium.dll" Link="pdfium.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
